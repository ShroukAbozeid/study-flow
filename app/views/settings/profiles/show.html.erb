<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>
  <h1 class="font-bold text-4xl">Profile</h1>
  <%= form_with model: Current.user, url: settings_profile_path, method: :patch, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :avatar, "Avatar", class: "block text-sm font-medium text-gray-700" %>
      <% if Current.user.avatar.attached? %>
        <div class="mt-2">
          <%= image_tag Current.user.avatar.variant(resize_to_limit: [100, 100]), class: "rounded-full" %>
        </div>
      <% end %>
      <%= form.file_field :avatar, accept: "image/*", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :name, required: true, autofocus: true, placeholder: "Enter your name", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.label :email_address, "Email", class: "block text-sm font-medium text-gray-700" %>
      <%= form.email_field :email_address, readonly: true, class: "bg-gray-100 block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="my-5">
      <%= form.label :time_zone, "Time Zone", class: "block text-sm font-medium text-gray-700" %>
      <%= form.select :time_zone, ActiveSupport::TimeZone.all.map(&:name), { prompt: "Select your time zone" }, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "Update Profile", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>
      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to "Back to Dashboard", dashboard_show_path, class: "text-gray-700 underline" %>
      </div>
    </div>
  <% end %>
</div>
