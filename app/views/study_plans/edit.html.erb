<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>

  <h1 class="font-bold text-4xl">Update Study Plan</h1>

  <%= form_with model: @study_plan, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :name, required: true, autofocus: true, placeholder: "Enter study plan name", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.text_field :description, placeholder: "Enter study plan description", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <div class="my-5">
      <%= form.number_field :daily_hour, placeholder: "Enter daily hours", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>

    <%= turbo_frame_tag "topics" do %>
      <h2 class="font-bold text-2xl mt-6">Topics</h2>
      <ul class="mt-4">
        <% @study_plan.topics.each do |topic| %>
          <%= turbo_frame_tag dom_id(topic) do %>
            <li class="mb-2">
              <%= render "topics/topic", topic: topic %>
            </li>
          <% end %>
        <% end %>
      </ul>
    <% end %>

    <%= turbo_frame_tag "new_topic" do %>
      <%= link_to "Add a Topic", new_topic_path(study_plan_id: @study_plan.id), class: "text-blue-600 underline" %>
    <% end %>

    <div class="col-span-6 sm:flex sm:items-center sm:gap-4">
      <div class="inline">
        <%= form.submit "Update Study Plan", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
      </div>

      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to "Back to Dashboard", dashboard_show_path, class: "text-gray-700 underline" %>
      </div>
    </div>
  <% end %>
</div>
