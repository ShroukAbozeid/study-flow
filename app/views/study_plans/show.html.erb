<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>
  <h1 class="font-bold text-4xl"><%= @study_plan.name %></h1>
  <%= link_to "Edit", edit_study_plan_path(@study_plan), class: "text-blue-600 underline ml-2" %>
  <p class="mt-2">Description: <%=@study_plan.description%></p>
  <p class="mt-2">Daily Hour: <%=@study_plan.daily_hour%></p>
  <%= turbo_frame_tag "topics" do %>
    <h2 class="font-bold text-2xl mt-6">Topics</h2>
    <ul class="mt-4">
      <% @study_plan.topics.each do |topic| %>
        <%= turbo_frame_tag dom_id(topic) do %>
          <li class="mb-2">
            <%= render "topics/topic", topic: topic %>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% end %>
  <%= turbo_frame_tag "new_topic" do %>
    <%= link_to "Add a Topic", new_topic_path(study_plan_id: @study_plan.id), class: "text-blue-600 underline" %>
  <% end %>
</div>
