<div>
  <h1 class="font-bold text-4xl">Notifications</h1>
  <%= link_to "Mark All as Read", mark_all_read_notifications_path, data: { turbo_method: :patch }, class: "text-blue-600 underline ml-2" %>
  <%= render "shared/alert" %>
  <% @notifications.each do |notification| %>
    <%= turbo_frame_tag notification do %>
      <% if notification.read %>
        <div class="border border-grey-300 p-4 mb-4">
          <h2 class="font-bold text-xl"><%= notification.title %></h2>
          <p><%= notification.content %></p>
          <small><%= notification.created_at.strftime("%B %d, %Y") %></small>
          <%= link_to "Mark as Unread", mark_unread_notification_path(notification), data: { turbo_method: :patch }, class: "text-blue-600 underline ml-2" %>
        </div>
      <% else %>
        <div class="border border-green-300 p-4 mb-4">
          <h2 class="font-bold text-xl"><%= notification.title %></h2>
          <p><%= notification.content %></p>
          <small><%= notification.created_at.strftime("%B %d, %Y") %></small>
          <%= link_to "Mark as Read", mark_read_notification_path(notification), data: { turbo_method: :patch }, class: "text-blue-600 underline ml-2" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
