<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>
  <h1 class="font-bold text-4xl">Start a study session</h1>
  <%= turbo_frame_tag @study_session.topic do %>
    <p><%= @study_session.topic.name %></p>
    <%= turbo_frame_tag "#{@study_session.topic_id}_new_study_session" do %>
      <%= form_with model: @study_session do |form| %>
        <%= form.hidden_field :topic_id, value: @study_session.topic_id %>
        <div class="my-5">
          <%= form.label :title, "Title", class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :title, required: true, autofocus: true, placeholder: "title", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
        <div class="my-5 mx-2">
          <%= form.label :notes, "Notes", class: "block text-sm font-medium text-gray-700" %>
          <%= form.rich_textarea :notes, placeholder: "notes", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
        </div>
        <div class="col-span-6 sm:flex sm:items-center sm:gap-4 mt-2">
          <div class="inline">
            <%= form.submit "Start session", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <div class="mt-4 text-sm text-gray-500 sm:mt-0">
    <%= link_to "Back to Study Plan", study_plan_path(@study_session.topic.study_plan), class: "text-gray-700 underline" %>
  </div>
</div>
