<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>
  <h1 class="font-bold text-4xl">Update Topic</h1>
  <%= turbo_frame_tag @topic do %>
    <%= form_with model: @topic, class: "flex flex-col" do |form| %>
      <%= form.hidden_field :study_plan_id, value: @topic.study_plan_id %>
      <div class="my-5">
        <%= form.label :name, "Name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: "name", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="my-2 mr-2">
        <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :description, placeholder: "description", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="my-2 mr-2">
        <%= form.label :estimated_hours, "Estimated Hours", class: "block text-sm font-medium text-gray-700" %>
        <%= form.number_field :estimated_hours, required: true, placeholder: "estimated hours", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      </div>
      <div class="my-2 mr-2">
        <%= form.label :resources, "Resources", class: "block text-sm font-medium text-gray-700" %>
        <ul>
          <% @topic.resources.attachments.select(&:persisted?).each do |attachment| %>
            <% resource = attachment.blob %>
            <li><%= link_to resource.filename.to_s, url_for(resource), target: "_blank" %></li>
          <% end %>
        </ul>
        <% @topic.resources.attachments.select(&:persisted?).each do |attachment| %>
          <% resource = attachment.blob %>
          <%= form.hidden_field :resources, multiple: true, value: resource.signed_id %>
        <% end %>
        <%= form.label :resources, "Add New Resources", class: "block text-sm font-medium text-gray-700" %>
        <p>PDF, Word, PowerPoint, Excel, image, and text files up to 20 MB each (10 files maximum).</p>
        <%= form.file_field :resources, multiple: true, accept: Topic::RESOURCE_CONTENT_TYPES.join(",") %>
      </div>
      <div class="col-span-6 sm:flex sm:items-center sm:gap-4 mt-2">
        <div class="inline">
          <%= form.submit "Update Topic", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
        </div>
      </div>
    <% end %>
  <% end %>
  <div class="mt-4 text-sm text-gray-500 sm:mt-0">
    <%= link_to "Back to Study Plan", study_plans_path(@topic.study_plan), class: "text-gray-700 underline" %>
  </div>
</div>
