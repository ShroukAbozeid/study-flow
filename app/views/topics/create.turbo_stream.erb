<%= turbo_stream.append "topics" do %>
  <%= turbo_frame_tag dom_id(@topic) do %>
    <li class="mb-2">
      <%= render partial: "topics/topic", locals: { topic: @topic } %>
    </li>
  <% end %>
<% end %>
<%= turbo_stream.update "new_topic" do %>
  <%= link_to "Add a Topic", new_topic_path(study_plan_id: @topic.study_plan_id), class: "text-blue-600 underline" %>
<% end %>
