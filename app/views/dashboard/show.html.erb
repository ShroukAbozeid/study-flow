<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/alert" %>

  <div class="flex justify-between items-center">
    <div class="mt-4 text-sm text-gray-500 sm:mt-0">
      <%= turbo_stream_from Current.user, :unread_notifications_count %>
      
      <%= link_to notifications_path do %>
        <%= render "notifications/unread_count", count: Current.user.notifications.unread.count %> Notifications
      <% end %>
    </div>
    <div class="mt-4 text-sm text-gray-500 sm:mt-0">
      <%= link_to "Log Out", session_path,data: { turbo_method: :delete }, class: "text-gray-700 underline" %>
    </div>
  </div>


  <h1 class="font-bold text-4xl">Dashboard</h1>
<div>
  <% if @study_plans.any? %>
    <h2 class="font-bold text-2xl mt-6">Your Study Plans</h2>
    <ul class="mt-4">
      <% @study_plans.each do |plan| %>
        <li class="mb-2">
          <%= link_to plan.name, study_plan_path(plan), class: "text-blue-600 underline ml-2" %>
          <%= link_to "Edit", edit_study_plan_path(plan), class: "text-blue-600 underline ml-2" %>
          <%= link_to "Delete", study_plan_path(plan),  data: { turbo_method: :delete, turbo_confirm: 'Are you sure?'}, class: "text-red-600 underline ml-2" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500">You have no study plans yet.</p>
  <% end %>
  <%= link_to "Create a Study Plan", new_study_plan_path, class: "text-blue-600 underline" %>
</div>

  <div>
    <h2 class="font-bold text-2xl mt-6">Active Study Sessions</h2>
    <ul class="mt-4">
      <% @ongoing_study_sessions.each do |study_session| %>
        <%= turbo_frame_tag "active_#{study_session.id}" do%>
          <p><%= study_session.topic.study_plan.name %> - <%= study_session.topic.name %></p>
          <%= turbo_frame_tag study_session do %>
            <li class="mb-2">
              <%= render "study_sessions/session", session: study_session %>
            </li>
          <% end %>
        <%end%>
      <% end %>
    </ul>
  </div>

    <div>
    <h2 class="font-bold text-2xl mt-6">Study Sessions Completed Today</h2>
    <ul class="mt-4">
      <%= turbo_frame_tag "completed_sessions" do %>
        <% @completed_today_sessions.each do |study_session| %>
          <p><%= study_session.topic.study_plan.name %> - <%= study_session.topic.name %></p>
          <%= turbo_frame_tag study_session do %>
            <li class="mb-2">
              <%= render "study_sessions/session", session: study_session %>
            </li>
          <% end %>
        <% end %>
      <%end %>
    </ul>
  </div>

</div>

